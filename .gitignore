# 密钥：绝对不要提交（任何名字带 secrets 的文件一律排除，宁可误伤）
config/secrets.yaml
config/secrets.yml
config/secrets.json
config/secrets.web.yaml
config/secrets.web.yml
config/secrets.web.json
config/secrets*.local-backup*

# 本地个人配置备份（开源清理时手工留的）
config/*.local-backup*

# 环境变量文件：密钥最常见的载体，一条也别放过
.env
.env.*

# 手工备份 / 证书 / 私钥 / patch 残渣
# 审计确认过仓库里目前没有这类文件，加在这里是防手滑：
# 配置页面或手工调试留下的 models.web.yaml.bak-YYYYmmdd-HHMMSS 也在这条覆盖范围内。
*.bak
*.bak-*
*.orig
*.rej
*.key
*.pem
*.p12
*.pfx

# 说明：config/models.web.yaml 是配置页面生成的厂商/模型清单，
# 里面只有环境变量名、没有密钥，按设计是可以提交的。

# 运行时状态与产物
state/
outputs/

# Agent 工具数据：WorkBuddy 的项目记忆/笔记本，含内部排查笔记与本地环境描述，
# 属于本机工具状态而不是这个 skill 的交付内容，不入库。
.workbuddy/

# Python
__pycache__/
*.py[cod]
*.egg-info/
# 虚拟环境：本项目零依赖，其实不需要 venv；真要建也别提交（几十 MB 且含绝对路径）
.venv/
venv/
env/
ENV/
virtualenv/
pyvenv.cfg

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
